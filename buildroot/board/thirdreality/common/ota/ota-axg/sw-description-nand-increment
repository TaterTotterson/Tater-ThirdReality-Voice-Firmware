software =
{
	version = "1.0.1";
	hardware-compatibility: [ "1.0" ];
	files: (
		{
			filename = "rootfs.tgz";
			path = "/tmp/rootfs.tgz";
		}
	);
	scripts: (
		{
			filename = "update.sh";
			type = "shellscript";
		}
	);
	images: (
		{
			filename = "dtb.img";
			device = "/dev/dtb";
		},
		{
			filename = "boot.img";
			device = "/dev/mtd5";
			type = "flash";
		}
	);
}
