# NTP servers used for the initial clock sync.
# Servers learned from DHCP Option 42 are always preferred so a site can keep
# time synchronization fully local. The public fallback is restricted to the
# US-based NIST Internet Time Service; there are no hard-coded public IP
# addresses.
# Do not edit by hand; the hook overwrites this line on every lease change.
NTPSERVERS_DHCP=""
NTPSERVERS_DNS="time-a-g.nist.gov time-a-b.nist.gov time-a-wwv.nist.gov"

# Get initial time via ntpdate?
NTPDATE=yes
NTPDATE_OPTS="-4 -t 2 -p 1"

# Start the ntp daemon?
NTPD=yes
