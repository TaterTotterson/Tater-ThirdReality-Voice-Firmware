From: Tater Firmware <firmware@tater.local>
Subject: [PATCH] expose playback-reference echo cancellation

Keep the original noise-suppression and gain API compatible, while allowing
the S420 runtime to submit synchronized 10 ms playback-reference frames and
enable AEC only while the local speaker is genuinely rendering audio.

diff --git a/python.cpp b/python.cpp
index fc350f9..2ba90da 100644
--- a/python.cpp
+++ b/python.cpp
@@ -1,3 +1,5 @@
+#include <array>
+
 #include <pybind11/pybind11.h>
 #include <pybind11/stl.h>
 
@@ -26,19 +28,25 @@ private:
   webrtc::StreamConfig stream_config;
 
 public:
-  AudioProcessor(int auto_gain, int noise_suppression);
+  AudioProcessor(int auto_gain, int noise_suppression,
+                 bool echo_cancellation = false);
   ~AudioProcessor();
 
+  void SetEchoCancellation(bool enabled);
+  void ProcessReverse10ms(py::bytes audio);
   std::unique_ptr<ProcessedAudioChunk> Process10ms(py::bytes audio);
 };
 
 // auto_gain: 0 = disabled, max 31
 // noise_suppression: 0 = disabled, max 4
-AudioProcessor::AudioProcessor(int auto_gain, int noise_suppression)
+AudioProcessor::AudioProcessor(int auto_gain, int noise_suppression,
+                               bool echo_cancellation)
     : stream_config(16000, 1, false) {
   this->apm = webrtc::AudioProcessingBuilder().Create();
 
-  this->audio_config.echo_canceller.enabled = false;
+  this->audio_config.echo_canceller.enabled = echo_cancellation;
+  this->audio_config.echo_canceller.mobile_mode = false;
+  this->audio_config.echo_canceller.enforce_high_pass_filtering = true;
 
   if (auto_gain > 0) {
     this->audio_config.gain_controller1.enabled = true;
@@ -69,6 +77,26 @@ AudioProcessor::AudioProcessor(int auto_gain, int noise_suppression)
   this->apm->ApplyConfig(audio_config);
 }
 
+void AudioProcessor::SetEchoCancellation(bool enabled) {
+  if (this->audio_config.echo_canceller.enabled == enabled) {
+    return;
+  }
+  this->audio_config.echo_canceller.enabled = enabled;
+  this->apm->ApplyConfig(this->audio_config);
+}
+
+void AudioProcessor::ProcessReverse10ms(py::bytes audio) {
+  py::buffer_info buffer_input(py::buffer(audio).request());
+  if (buffer_input.size != BYTES_10_MS) {
+    throw std::runtime_error("Reference input must be 320 bytes (10 ms)");
+  }
+
+  std::array<int16_t, BYTES_10_MS / sizeof(int16_t)> output{};
+  this->apm->ProcessReverseStream(
+      static_cast<int16_t *>(buffer_input.ptr), this->stream_config,
+      this->stream_config, output.data());
+}
+
 std::unique_ptr<ProcessedAudioChunk>
 AudioProcessor::Process10ms(py::bytes audio) {
   auto processed_chunk = std::make_unique<ProcessedAudioChunk>();
@@ -79,9 +107,12 @@ AudioProcessor::Process10ms(py::bytes audio) {
   if ((buffer_input.size != BYTES_10_MS) ||
       (buffer_output.size != BYTES_10_MS)) {
     throw std::runtime_error(
         "Input and output buffers must be 320 bytes (10 ms)");
   }
 
+  if (this->audio_config.echo_canceller.enabled) {
+    this->apm->set_stream_delay_ms(0);
+  }
   this->apm->ProcessStream(static_cast<int16_t *>(buffer_input.ptr),
                            this->stream_config, this->stream_config,
                            static_cast<int16_t *>(buffer_output.ptr));
@@ -110,7 +141,11 @@ PYBIND11_MODULE(webrtc_noise_gain_cpp, m) {
     )pbdoc";
 
   py::class_<AudioProcessor>(m, "AudioProcessor")
-      .def(py::init<int, int>())
+      .def(py::init<int, int, bool>(), py::arg("auto_gain"),
+           py::arg("noise_suppression"),
+           py::arg("echo_cancellation") = false)
+      .def("SetEchoCancellation", &AudioProcessor::SetEchoCancellation)
+      .def("ProcessReverse10ms", &AudioProcessor::ProcessReverse10ms)
       .def("Process10ms", &AudioProcessor::Process10ms);
 
   py::class_<ProcessedAudioChunk>(m, "ProcessedAudioChunk")
-- 
