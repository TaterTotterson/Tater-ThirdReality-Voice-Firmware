From 08a996d85b44e22424639f6ac20a192017bf60d5 Mon Sep 17 00:00:00 2001
From: Codex Integration <codex@local>
Date: Thu, 27 Aug 2026 16:54:20 -0500
Subject: [PATCH] 0001-remove-zeroconf-discovery

---
 linux_voice_assistant/__main__.py       | 13 +------
 linux_voice_assistant/peripheral_api.py |  6 +--
 linux_voice_assistant/satellite.py      |  2 +-
 linux_voice_assistant/tater_native.py   |  2 +-
 linux_voice_assistant/zeroconf.py       | 50 -------------------------
 pyproject.toml                          |  1 -
 6 files changed, 6 insertions(+), 68 deletions(-)
 delete mode 100644 linux_voice_assistant/zeroconf.py

diff --git a/linux_voice_assistant/__main__.py b/linux_voice_assistant/__main__.py
index ad46ff0..0a3598a 100644
--- a/linux_voice_assistant/__main__.py
+++ b/linux_voice_assistant/__main__.py
@@ -32,7 +32,6 @@ from .util import (
 )
 from .wake_word import find_available_wake_words, load_stop_model, load_wake_models
 from .webrtc import WebRTCProcessor
-from .zeroconf import HomeAssistantZeroconf
 
 _LOGGER = logging.getLogger(__name__)
 _MODULE_DIR = Path(__file__).parent
@@ -597,22 +596,12 @@ async def main() -> None:
     )
     process_audio_thread.start()
 
-    # Auto discovery (zeroconf, mDNS) is only used by ESPHome server mode.
-    if native_client is None:
-        discovery = HomeAssistantZeroconf(
-            port=args.port,
-            name=state.name,
-            mac_address=state.mac_address,
-            host_ip_address=host_ip_address,
-        )
-        await discovery.register_server()
-
     # ------------------------------------------------------------------
     # Start peripheral API and signal "getting started" to peripherals
     # ------------------------------------------------------------------
     if peripheral_api is not None:
         await peripheral_api.start()
-        await peripheral_api.emit_event(LVAEvent.ZEROCONF, {"status": "getting_started"})
+        await peripheral_api.emit_event(LVAEvent.CONNECTION, {"status": "getting_started"})
 
         # Give peripherals a window to connect and register their Light
         # entities before HA enumerates over the ESPHome native API. The
diff --git a/linux_voice_assistant/peripheral_api.py b/linux_voice_assistant/peripheral_api.py
index 5eff953..0b66b4b 100644
--- a/linux_voice_assistant/peripheral_api.py
+++ b/linux_voice_assistant/peripheral_api.py
@@ -31,7 +31,7 @@ Feedback events emitted by LVA
               Emitted when the HA TCP connection is lost.
               Connected leds with peripheral containers should
               show a red twinkle / "no connection" animation and keep retrying
-              until they see a ``zeroconf`` event with status "connected".
+              until they see a ``connection`` event with status "connected".
               NOTE: if LVA itself is not running the peripheral container will
               see a WebSocket connection failure on its end — that is also
               a "disconnected" condition to handle with the same animation.
@@ -45,7 +45,7 @@ Feedback events emitted by LVA
                         voice pipeline announcements — those use tts_speaking.
   volume_changed        data: {"volume": 0.0–1.0}
   volume_muted          data: {"muted": true/false}
-  zeroconf              data: {"status": "getting_started" | "connected"}
+  connection            data: {"status": "getting_started" | "connected"}
   light_command         data: {"object_id": str, "state": bool, "brightness": float,
                               "red": float, "green": float, "blue": float, "effect": str}
               Fires when HA changes a Light entity that a peripheral
@@ -136,7 +136,7 @@ class LVAEvent(str, Enum):
     MEDIA_PLAYER_PLAYING = "media_player_playing"
     VOLUME_CHANGED = "volume_changed"
     VOLUME_MUTED = "volume_muted"
-    ZEROCONF = "zeroconf"
+    CONNECTION = "connection"
     LIGHT_COMMAND = "light_command"
     TOOL_CALL = "tool_call"
     SETTINGS = "settings"
diff --git a/linux_voice_assistant/satellite.py b/linux_voice_assistant/satellite.py
index 7b1afb0..b39cc5c 100644
--- a/linux_voice_assistant/satellite.py
+++ b/linux_voice_assistant/satellite.py
@@ -1271,7 +1271,7 @@ class VoiceSatelliteProtocol(APIServer):
             _LOGGER.debug("All entity states sent after connect")
 
             # Notify peripherals that Home Assistant is now connected
-            self._emit(LVAEvent.ZEROCONF, {"status": "connected"})
+            self._emit(LVAEvent.CONNECTION, {"status": "connected"})
 
     # ------------------------------------------------------------------
     # External wake word download
diff --git a/linux_voice_assistant/tater_native.py b/linux_voice_assistant/tater_native.py
index 9c5c3cc..d3f9645 100644
--- a/linux_voice_assistant/tater_native.py
+++ b/linux_voice_assistant/tater_native.py
@@ -421,7 +421,7 @@ class TaterNativeClient:
         self._connected = True
         self.state.connected = True
         self.state.satellite = self.satellite
-        self.satellite._emit(LVAEvent.ZEROCONF, {"status": "connected"})  # pylint: disable=protected-access
+        self.satellite._emit(LVAEvent.CONNECTION, {"status": "connected"})  # pylint: disable=protected-access
         _LOGGER.info(
             "Connected to Tater native satellite API selector=%s device_id=%s board=%s room=%s",
             ack_payload.get("selector") or f"native:{self.device_id}",
diff --git a/linux_voice_assistant/zeroconf.py b/linux_voice_assistant/zeroconf.py
deleted file mode 100644
index 3cd6119..0000000
--- a/linux_voice_assistant/zeroconf.py
+++ /dev/null
@@ -1,50 +0,0 @@
-"""Runs mDNS zeroconf service for Home Assistant discovery."""
-
-import logging
-import socket
-from typing import Optional
-
-_LOGGER = logging.getLogger(__name__)
-
-try:
-    from zeroconf.asyncio import AsyncServiceInfo, AsyncZeroconf
-except ImportError:
-    _LOGGER.fatal("zeroconf not installed. Please install it with: pip install zeroconf")
-    raise
-
-MDNS_TARGET_IP = "224.0.0.251"
-
-
-class HomeAssistantZeroconf:
-    def __init__(
-        self,
-        port: int,
-        mac_address: str,
-        host_ip_address: str,
-        name: Optional[str] = None,
-    ) -> None:
-        self.port = port
-        self.mac_address = mac_address
-        self.name = name or self.mac_address
-        self.host_ip_address = host_ip_address
-
-        self._aiozc = AsyncZeroconf()
-
-    async def register_server(self) -> None:
-
-        service_info = AsyncServiceInfo(
-            "_esphomelib._tcp.local.",
-            f"{self.name}._esphomelib._tcp.local.",
-            addresses=[socket.inet_aton(self.host_ip_address)],
-            port=self.port,
-            properties={
-                "version": "2025.9.0",
-                "mac": self.mac_address,
-                "board": "host",
-                "platform": "HOST",
-                "network": "ethernet",  # or "wifi"
-            },
-            server=f"{self.name}.local.",
-        )
-        await self._aiozc.async_register_service(service_info)
-        _LOGGER.debug("Zeroconf discovery enabled: %s", service_info)
