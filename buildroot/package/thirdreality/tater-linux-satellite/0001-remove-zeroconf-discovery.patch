@@ -29,7 +29,6 @@ dependencies = [
     "pymicro-wakeword>=2,<3",
     "pyopen-wakeword>=1,<2",
     "python-mpv>=1,<2",
-    "zeroconf<1",
     "getmac<1",
     "types-protobuf",
     "websockets==12",
