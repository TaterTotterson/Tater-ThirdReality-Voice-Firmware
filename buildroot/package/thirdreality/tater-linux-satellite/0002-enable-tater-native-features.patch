From 98d0f4db77ad067ac570f228cc59ea0d7c21223e Mon Sep 17 00:00:00 2001
From: Codex Integration <codex@local>
Date: Thu, 27 Aug 2026 16:54:20 -0500
Subject: [PATCH] 0002-enable-tater-native-features

---
 linux_voice_assistant/__main__.py       |  3 +-
 linux_voice_assistant/peripheral_api.py |  2 +-
 linux_voice_assistant/tater_native.py   | 39 +++++++++++--------------
 3 files changed, 20 insertions(+), 24 deletions(-)

diff --git a/linux_voice_assistant/__main__.py b/linux_voice_assistant/__main__.py
index 0a3598a..45645c0 100644
--- a/linux_voice_assistant/__main__.py
+++ b/linux_voice_assistant/__main__.py
@@ -271,6 +271,8 @@ async def main() -> None:
         help="Enable output only mode",
     )
     args = parser.parse_args()
+    if not args.tater_url:
+        parser.error("--tater-url is required; this build only supports Tater native mode")
 
     if args.list_input_devices:
         print("Audio Input devices:")
@@ -339,7 +341,6 @@ async def main() -> None:
 
     # Resolve esphome version
     esphome_version = get_esphome_version()
-    print(f"ESPHome api version: {esphome_version}")
 
     # Resolve download dir
     args.download_dir = Path(args.download_dir)
diff --git a/linux_voice_assistant/peripheral_api.py b/linux_voice_assistant/peripheral_api.py
index 0b66b4b..9d9058a 100644
--- a/linux_voice_assistant/peripheral_api.py
+++ b/linux_voice_assistant/peripheral_api.py
@@ -269,7 +269,7 @@ class PeripheralAPIServer:
                 "data": {
                     "muted": state.muted,
                     "volume": round(state.volume, 3),
-                    "ha_connected": state.connected,
+                    "tater_connected": state.connected,
                     "last_stt_text": self._last_stt_text,
                     "last_tts_text": self._last_tts_text,
                     "settings": dict(state.native_settings),
diff --git a/linux_voice_assistant/tater_native.py b/linux_voice_assistant/tater_native.py
index d3f9645..da9564b 100644
--- a/linux_voice_assistant/tater_native.py
+++ b/linux_voice_assistant/tater_native.py
@@ -34,6 +34,7 @@ from aioesphomeapi.model import VoiceAssistantEventType
 from google.protobuf import message
 
 from .peripheral_api import LVAEvent
+from .tater_features import TaterFeatureManager
 
 _LOGGER = logging.getLogger(__name__)
 
@@ -183,6 +184,9 @@ class TaterNativeClient:
                 }
             )
 
+        self.features = TaterFeatureManager(self)
+        self.capabilities.update(self.features.capabilities)
+
         self._loop: Optional[asyncio.AbstractEventLoop] = None
         self._stop: Optional[asyncio.Event] = None
         self._websocket: Any = None
@@ -421,6 +425,7 @@ class TaterNativeClient:
         self._connected = True
         self.state.connected = True
         self.state.satellite = self.satellite
+        self.features.connected()
         self.satellite._emit(LVAEvent.CONNECTION, {"status": "connected"})  # pylint: disable=protected-access
         _LOGGER.info(
             "Connected to Tater native satellite API selector=%s device_id=%s board=%s room=%s",
@@ -436,13 +441,13 @@ class TaterNativeClient:
         self._voice_start_pending = False
         self._audio_preroll.clear()
         self._clear_outgoing()
+        self.features.disconnected()
         if not was_connected:
             return
         try:
             self.satellite.connection_lost(error)
         finally:
-            # VoiceSatelliteProtocol normally gets reconstructed by the ESPHome
-            # server after a disconnect. Native mode reconnects the same object.
+            # Tater native mode reconnects the same local audio state machine.
             self.state.satellite = self.satellite
             self.state.connected = False
 
@@ -477,15 +482,17 @@ class TaterNativeClient:
                 state = "speaking" if tts_response_active or bool(getattr(self.satellite, "_tts_played", False)) else "thinking"
             elif self._media_session_id:
                 state = "playing"
+            status_payload = {
+                "state": state,
+                "uptime_s": int(time.monotonic() - self._started_monotonic),
+                "connected": True,
+                "audio_tx_dropped": self._audio_drops,
+            }
+            status_payload.update(self.features.status())
             self._queue_frame(
                 _json_frame(
                     "status",
-                    {
-                        "state": state,
-                        "uptime_s": int(time.monotonic() - self._started_monotonic),
-                        "connected": True,
-                        "audio_tx_dropped": self._audio_drops,
-                    },
+                    status_payload,
                 )
             )
 
@@ -494,20 +501,7 @@ class TaterNativeClient:
         raw_payload = body.get("payload")
         payload: dict[str, Any] = raw_payload if isinstance(raw_payload, dict) else {}
 
-        if message_type == "settings":
-            from .live_settings import apply_live_settings
-
-            try:
-                applied = apply_live_settings(self.state, payload)
-                result = {"ok": True, "settings": applied}
-            except Exception as exc:  # pylint: disable=broad-except
-                _LOGGER.exception("Could not apply Tater live settings")
-                result = {
-                    "ok": False,
-                    "error": str(exc),
-                    "settings": dict(getattr(self.state, "native_settings", {}) or {}),
-                }
-            self._submit_frame(_json_frame("settings.changed", result, message_id=str(body.get("id") or "")))
+        if self.features.handle_message(body):
             return
 
         if message_type == "voice.event":
@@ -765,6 +759,7 @@ class TaterNativeClient:
         self._submit_frame(_json_frame(message_type, event_payload))
 
     async def close(self) -> None:
+        await self.features.close()
         stop = self._stop
         if stop is not None:
             stop.set()
-- 
2.46.0

