From 47dddc107d7c8e233247383213c24348385614f7 Mon Sep 17 00:00:00 2001
From: Tater Firmware <firmware@tater.local>
Date: Wed, 5 Aug 2026 12:00:00 -0500
Subject: [PATCH] add Tater synchronized mpv controls

Expose the small set of libmpv primitives needed by the Tater audio-session
v2 implementation.  The device-specific session coordinator remains in the
S420 firmware overlay while the generic player owns mpv access and locking.
---
 linux_voice_assistant/mpv_player.py    | 43 ++++++++++++++++
 linux_voice_assistant/player/libmpv.py | 83 ++++++++++++++++++++++++++++-
 2 files changed, 125 insertions(+), 1 deletion(-)

diff --git a/linux_voice_assistant/mpv_player.py b/linux_voice_assistant/mpv_player.py
index e821776..4647ba7 100644
--- a/linux_voice_assistant/mpv_player.py
+++ b/linux_voice_assistant/mpv_player.py
@@ -63,6 +63,49 @@ class MpvMediaPlayer:
         next_url = self._playlist.pop(0)
         self._player.play(next_url, done_callback=self._on_track_finished, stop_first=stop_first)
 
+    def prepare_synchronized(
+        self,
+        url: str,
+        *,
+        channel: str = "stereo",
+        loop: bool = False,
+        done_callback: Optional[Callable[[], None]] = None,
+    ) -> None:
+        """Load one media URL paused for a clock-scheduled Tater start."""
+        if self._done_callback is not None:
+            if self._player.state() != PlayerState.IDLE:
+                self._player.stop(for_replacement=True)
+            self._done_callback = None
+        self._playlist = []
+        self._done_callback = done_callback
+        self._player.prepare_synchronized(
+            url,
+            channel=channel,
+            loop=loop,
+            done_callback=self._on_track_finished,
+        )
+
+    def synchronized_snapshot(self) -> dict:
+        """Return the current mpv clock/cache state for Tater telemetry."""
+        return self._player.synchronized_snapshot()
+
+    def seek_synchronized(self, position_seconds: float) -> None:
+        """Seek the prepared media timeline without resuming playback."""
+        self._player.seek_synchronized(position_seconds)
+
+    def set_synchronized_speed(self, speed: float) -> None:
+        """Apply a tiny temporary rate slew used for drift correction."""
+        self._player.set_synchronized_speed(speed)
+
+    def reset_synchronized(self) -> None:
+        """Restore normal rate and stereo routing after a Tater session."""
+        self._player.reset_synchronized()
+
+    @property
+    def synchronized_controls_available(self) -> bool:
+        """Allow firmware overlays to advertise sync only with this API."""
+        return True
+
     def _on_track_finished(self) -> None:
         """Called when a track finishes - plays next or invokes done callback."""
         if self._playlist:
diff --git a/linux_voice_assistant/player/libmpv.py b/linux_voice_assistant/player/libmpv.py
index 82e38a6..51aa980 100644
--- a/linux_voice_assistant/player/libmpv.py
+++ b/linux_voice_assistant/player/libmpv.py
@@ -1,11 +1,19 @@
 import logging
 import threading
-from typing import Callable, Optional
+from typing import Any, Callable, Dict, Optional
 
 import mpv
 
 from linux_voice_assistant.player.base import AudioPlayer
 from linux_voice_assistant.player.state import PlayerState
+
+
+_TATER_CHANNEL_FILTERS = {
+    "stereo": "",
+    "left": "lavfi=[pan=stereo|c0=c0|c1=c0]",
+    "right": "lavfi=[pan=stereo|c0=c1|c1=c1]",
+    "mono": "lavfi=[pan=stereo|c0=0.5*c0+0.5*c1|c1=0.5*c0+0.5*c1]",
+}
 
 
 class LibMpvPlayer(AudioPlayer):
@@ -83,6 +91,80 @@ class LibMpvPlayer(AudioPlayer):
         self._mpv.pause = stop_first
         self._mpv.play(url)
 
+    def prepare_synchronized(
+        self,
+        url: str,
+        *,
+        channel: str = "stereo",
+        loop: bool = False,
+        done_callback: Optional[Callable[[], None]] = None,
+    ) -> None:
+        """Load media paused with deterministic channel routing."""
+        normalized_channel = str(channel or "stereo").strip().lower()
+        audio_filter = _TATER_CHANNEL_FILTERS.get(
+            normalized_channel,
+            _TATER_CHANNEL_FILTERS["stereo"],
+        )
+        with self._state_lock:
+            self._done_callback = done_callback
+            self._set_state(PlayerState.LOADING)
+        self._mpv.pause = True
+        self._mpv.speed = 1.0
+        self._mpv.audio_pitch_correction = False
+        self._mpv.loop_file = "inf" if loop else "no"
+        self._mpv.command("af", "set", audio_filter)
+        self._mpv.play(url)
+
+    def _mpv_property(self, name: str, default: Any = None) -> Any:
+        try:
+            value = getattr(self._mpv, name)
+        except Exception:  # libmpv properties may be unavailable while loading
+            return default
+        return default if value is None else value
+
+    def synchronized_snapshot(self) -> Dict[str, Any]:
+        """Read timeline and cache properties as one thread-safe snapshot."""
+        with self._state_lock:
+            timeline_position = self._mpv_property("time_pos")
+            rendered_position = self._mpv_property("audio_pts")
+            position = rendered_position if rendered_position is not None else timeline_position
+            cache_duration = self._mpv_property("demuxer_cache_duration", 0.0)
+            return {
+                "loaded": position is not None,
+                "position_seconds": max(0.0, float(position or 0.0)),
+                "timeline_position_seconds": max(0.0, float(timeline_position or 0.0)),
+                "rendered_position_seconds": max(0.0, float(position or 0.0)),
+                "buffered_seconds": max(0.0, float(cache_duration or 0.0)),
+                "seeking": bool(self._mpv_property("seeking", False)),
+                "rebuffering": bool(
+                    self._mpv_property("paused_for_cache", False)
+                ),
+                "paused": bool(self._mpv_property("pause", False)),
+                "speed": float(self._mpv_property("speed", 1.0) or 1.0),
+            }
+
+    def seek_synchronized(self, position_seconds: float) -> None:
+        """Seek to an absolute media position while retaining pause state."""
+        with self._state_lock:
+            self._mpv.command(
+                "seek",
+                max(0.0, float(position_seconds)),
+                "absolute+exact",
+            )
+
+    def set_synchronized_speed(self, speed: float) -> None:
+        """Set a narrowly clamped rate for transparent clock correction."""
+        with self._state_lock:
+            self._mpv.speed = max(0.995, min(1.005, float(speed)))
+
+    def reset_synchronized(self) -> None:
+        """Restore defaults so ordinary local playback is unaffected."""
+        with self._state_lock:
+            self._mpv.speed = 1.0
+            self._mpv.audio_pitch_correction = True
+            self._mpv.loop_file = "no"
+            self._mpv.command("af", "set", "")
+
     def pause(self) -> None:
         """Pause playback."""
         with self._state_lock:
