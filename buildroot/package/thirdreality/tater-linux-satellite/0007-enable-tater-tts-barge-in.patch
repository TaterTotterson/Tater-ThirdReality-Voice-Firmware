From ba736e64b65d50bb0113a86780b57c21e6cd53d0 Mon Sep 17 00:00:00 2001
From: Codex Integration <codex@local>
Date: Thu, 27 Aug 2026 16:54:20 -0500
Subject: [PATCH] 0007-enable-tater-tts-barge-in

---
 linux_voice_assistant/satellite.py | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/linux_voice_assistant/satellite.py b/linux_voice_assistant/satellite.py
index b39cc5c..a145f49 100644
--- a/linux_voice_assistant/satellite.py
+++ b/linux_voice_assistant/satellite.py
@@ -982,8 +982,13 @@ class VoiceSatelliteProtocol(APIServer):
             return
 
         if self._pipeline_active:
-            _LOGGER.debug("Ignoring wake word - pipeline already active")
-            return
+            barge_in = bool(getattr(self, "_tater_barge_in_enabled", False))
+            if (not barge_in) or (not self.tts_response_active):
+                _LOGGER.debug("Ignoring wake word - pipeline already active")
+                return
+            _LOGGER.info("Tater wake word interrupted the active TTS response")
+            self._continue_conversation = False
+            self.stop()
 
         wake_word_phrase = wake_word.wake_word  # type: ignore[union-attr]
         _LOGGER.debug("Detected wake word: %s", wake_word_phrase)
-- 
2.46.0

