#!/bin/sh
#
# S99tater-satellite: Tater S420 runtime supervisor.
#
# Manages:
#   - Tater setup AP   (first boot or physical setup reset)
#   - netmonitor       (WiFi/internet connectivity state machine)
#   - voice-assistant  (/usr/bin/tater-satellite)
#   - hardware-bridge  (/usr/bin/tater-thirdreality-bridge)
#   - pulseaudio       (reboot device if it dies)
#
# Usage:
#   S99tater-satellite start|stop|restart
#   S99tater-satellite <service> start|stop|restart
#
# Services: netmonitor, voice-assistant, hardware-bridge

PIDDIR=/var/run/thirdreality
MONITOR_PIDFILE=$PIDDIR/tater-satellite.pid
NETMONITOR_PIDFILE=$PIDDIR/netmonitor.pid
VOICE_PIDFILE=$PIDDIR/voice-assistant.pid
BRIDGE_PIDFILE=$PIDDIR/hardware-bridge.pid

VOICE_ASSISTANT=/usr/bin/tater-satellite
HARDWARE_BRIDGE=/usr/bin/tater-thirdreality-bridge
PROVISIONING=/usr/bin/tater-provisioning
PROVISIONING_MARKER=/tmp/tater-provisioning-active

CHECK_INTERVAL=10

# Disable flag files: when present, the monitor loop skips restarting that service.
# Created by:  S99tater-satellite <service> stop
# Removed by:  S99tater-satellite <service> start
DISABLE_NETMONITOR=/tmp/tater_disable_netmonitor
DISABLE_VOICE=/tmp/tater_disable_voice
DISABLE_BRIDGE=/tmp/tater_disable_bridge

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

is_running() {
    local pidfile="$1"
    [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

# ---------------------------------------------------------------------------
# netmonitor
# ---------------------------------------------------------------------------

start_netmonitor() {
    is_running "$NETMONITOR_PIDFILE" && return 0
    rm -f "$NETMONITOR_PIDFILE" "$DISABLE_NETMONITOR"
    /usr/share/thirdreality/script/netmonitor &
    echo $! > "$NETMONITOR_PIDFILE"
}

stop_netmonitor() {
    touch "$DISABLE_NETMONITOR"
    if is_running "$NETMONITOR_PIDFILE"; then
        kill "$(cat "$NETMONITOR_PIDFILE")" 2>/dev/null
    fi
    rm -f "$NETMONITOR_PIDFILE"
}

# ---------------------------------------------------------------------------
# voice-assistant
# ---------------------------------------------------------------------------

start_voice_assistant() {
    is_running "$VOICE_PIDFILE" && return 0
    rm -f "$VOICE_PIDFILE" "$DISABLE_VOICE"
    "$VOICE_ASSISTANT" &
    echo $! > "$VOICE_PIDFILE"
}

stop_voice_assistant() {
    touch "$DISABLE_VOICE"
    if is_running "$VOICE_PIDFILE"; then
        kill "$(cat "$VOICE_PIDFILE")" 2>/dev/null
        sleep 1
        kill -9 "$(cat "$VOICE_PIDFILE")" 2>/dev/null
    fi
    rm -f "$VOICE_PIDFILE"
}

# ---------------------------------------------------------------------------
# ThirdReality hardware bridge
# ---------------------------------------------------------------------------

start_hardware_bridge() {
    is_running "$BRIDGE_PIDFILE" && return 0
    rm -f "$BRIDGE_PIDFILE" "$DISABLE_BRIDGE"
    "$HARDWARE_BRIDGE" &
    echo $! > "$BRIDGE_PIDFILE"
}

stop_hardware_bridge() {
    touch "$DISABLE_BRIDGE"
    if is_running "$BRIDGE_PIDFILE"; then
        kill "$(cat "$BRIDGE_PIDFILE")" 2>/dev/null
    fi
    rm -f "$BRIDGE_PIDFILE"
}

# ---------------------------------------------------------------------------
# Monitor loop
# ---------------------------------------------------------------------------

monitor_loop() {
    while true; do
        # 1. netmonitor
        if [ ! -f "$DISABLE_NETMONITOR" ] && ! is_running "$NETMONITOR_PIDFILE"; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] netmonitor not running, restarting..."
            start_netmonitor
        fi

        # 2. voice-assistant
        if [ ! -f "$DISABLE_VOICE" ] && ! is_running "$VOICE_PIDFILE"; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] voice-assistant not running, restarting..."
            start_voice_assistant
        fi

        # 3. hardware bridge
        if [ ! -f "$DISABLE_BRIDGE" ] && ! is_running "$BRIDGE_PIDFILE"; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] hardware bridge not running, restarting..."
            start_hardware_bridge
        fi

        # 4. pulseaudio
        if ! pidof pulseaudio > /dev/null 2>&1; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] pulseaudio died, rebooting..."
            sync
            sleep 3
            reboot -f
        fi

        sleep $CHECK_INTERVAL
    done
}

provisioning_monitor_loop() {
    while true; do
        "$PROVISIONING" ensure

        if ! pidof pulseaudio > /dev/null 2>&1; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] pulseaudio died during setup, rebooting..."
            sync
            sleep 3
            reboot -f
        fi

        sleep $CHECK_INTERVAL
    done
}

# ---------------------------------------------------------------------------
# Daemon lifecycle
# ---------------------------------------------------------------------------

start() {
    mkdir -p "$PIDDIR"

    if is_running "$MONITOR_PIDFILE"; then
        echo "Tater satellite already running (PID: $(cat "$MONITOR_PIDFILE"))"
        exit 0
    fi

    /usr/share/thirdreality/script/setup_env.sh

    if "$PROVISIONING" needs-setup; then
        "$PROVISIONING" start
        paplay /usr/share/thirdreality/audio/setup_mode.wav &
        provisioning_monitor_loop &
        echo $! > "$MONITOR_PIDFILE"
        echo "Tater setup hotspot started (PID: $(cat "$MONITOR_PIDFILE"))"
        return 0
    fi

    start_netmonitor
    start_hardware_bridge
    start_voice_assistant

    monitor_loop &
    echo $! > "$MONITOR_PIDFILE"
    echo "Tater satellite started (PID: $(cat "$MONITOR_PIDFILE"))"
}

stop() {
    if is_running "$MONITOR_PIDFILE"; then
        kill "$(cat "$MONITOR_PIDFILE")" 2>/dev/null
        echo "Tater satellite stopped (PID: $(cat "$MONITOR_PIDFILE"))"
    else
        echo "Tater satellite not running"
    fi
    rm -f "$MONITOR_PIDFILE"

    if [ -f "$PROVISIONING_MARKER" ]; then
        "$PROVISIONING" stop
    fi
    stop_voice_assistant
    stop_hardware_bridge
    stop_netmonitor
    # Clear disable flags so next start brings everything up
    rm -f "$DISABLE_NETMONITOR" "$DISABLE_VOICE" "$DISABLE_BRIDGE"
}

restart() {
    stop
    sleep 1
    start
}

# ---------------------------------------------------------------------------
# Per-service subcommands:  S99tater-satellite <service> start|stop|restart
# ---------------------------------------------------------------------------

service_cmd() {
    local svc="$1"
    local action="$2"
    case "$svc" in
        netmonitor)
            case "$action" in
                start)   start_netmonitor ;;
                stop)    stop_netmonitor ;;
                restart) stop_netmonitor; sleep 1; start_netmonitor ;;
                *) echo "Usage: $0 netmonitor {start|stop|restart}"; exit 1 ;;
            esac
            ;;
        voice-assistant)
            case "$action" in
                start)   start_voice_assistant ;;
                stop)    stop_voice_assistant ;;
                restart) stop_voice_assistant; sleep 1; start_voice_assistant ;;
                *) echo "Usage: $0 voice-assistant {start|stop|restart}"; exit 1 ;;
            esac
            ;;
        hardware-bridge)
            case "$action" in
                start)   start_hardware_bridge ;;
                stop)    stop_hardware_bridge ;;
                restart) stop_hardware_bridge; sleep 1; start_hardware_bridge ;;
                *) echo "Usage: $0 hardware-bridge {start|stop|restart}"; exit 1 ;;
            esac
            ;;
        *)
            echo "Unknown service: $svc"
            echo "Services: netmonitor, voice-assistant, hardware-bridge"
            exit 1
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

case "$1" in
    start)   start   ;;
    stop)    stop    ;;
    restart) restart ;;
    netmonitor|voice-assistant|hardware-bridge)
        service_cmd "$1" "$2"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        echo "       $0 {netmonitor|voice-assistant|hardware-bridge} {start|stop|restart}"
        exit 1
        ;;
esac
